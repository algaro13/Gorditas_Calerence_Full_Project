# El backend carga .env.<NODE_ENV> y luego .env; las variables ya presentes en el entorno tienen prioridad.
# `npm run dev:up` / `npm run prod:bootstrap` (raíz) escriben .env.development / .env.production con los
# ids de Zitadel. Este archivo solo documenta las variables.

NODE_ENV=development
PORT=5000
LOG_LEVEL=info
APP_TZ=America/Mexico_City

# PostgreSQL: runtime sin BYPASSRLS (pos_app) y migraciones (pos_migrator). En producción las inyecta docker compose.
DATABASE_URL=postgresql://pos_app:pos_app_dev@localhost:5432/kustodela?schema=public&connection_limit=15
DIRECT_URL=postgresql://pos_migrator:pos_migrator_dev@localhost:5432/kustodela?schema=public

# Dominio (nunca se escribe en código)
APP_DOMAIN=localhost
APP_SCHEME=http
FRONTEND_BASE_URL=http://localhost:5173

# Zitadel (los ids los escribe el bootstrap)
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_JWKS_URL=http://localhost:8080/oauth/v2/keys
ZITADEL_JWKS_MODE=remote
ZITADEL_API_URL=http://localhost:8080
ZITADEL_AUDIENCE=
ZITADEL_PROJECT_ID=
ZITADEL_DEFAULT_ORG_ID=
ZITADEL_SPA_APP_ID=
ZITADEL_PAT=
IDENTITY_PROVIDER=zitadel

# Stripe. Sin claves, PAYMENT_PROVIDER=fake (solo desarrollo y pruebas).
PAYMENT_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PROFESIONAL=
STRIPE_PRICE_EMPRESARIAL=

UPLOADS_DIR=uploads
