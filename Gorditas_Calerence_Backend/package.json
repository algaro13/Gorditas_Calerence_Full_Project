{
  "name": "kustodela-pos-api",
  "version": "2.0.0",
  "description": "API de Kustodela POS: punto de venta multi-tenant para restaurantes (Express + Prisma + PostgreSQL RLS + Zitadel)",
  "main": "dist/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "migrate:deploy": "dotenv -e .env.development -- prisma migrate deploy",
    "migrate:deploy:prod": "prisma migrate deploy",
    "migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:studio": "dotenv -e .env.development -- prisma studio",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "postinstall": "prisma generate",
    "sync:redirect-uris": "tsx scripts/sync-redirect-uris.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^7.2.0",
    "joi": "^17.13.3",
    "jose": "^6.0.11",
    "multer": "^2.0.2",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "stripe": "^22.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/supertest": "^6.0.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.29.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.16.2",
    "supertest": "^7.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "restaurant",
    "pos",
    "saas",
    "multi-tenant",
    "express",
    "prisma",
    "postgresql"
  ],
  "license": "UNLICENSED",
  "private": true
}
