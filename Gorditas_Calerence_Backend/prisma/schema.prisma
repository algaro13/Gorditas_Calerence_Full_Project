// Kustodela POS: una sola base PostgreSQL, tenant_id en toda tabla de negocio y
// Row Level Security forzada (ver prisma/sql/rls.sql). La aplicación nunca escribe
// tenant_id: lo pone el DEFAULT current_tenant_id() a partir de SET LOCAL app.tenant_id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum OrdenEstatus {
  Pendiente
  Recepcion
  Preparacion
  Surtida
  Entregada
  Pagada
  Cancelado
}

/// Las tres formas que puede tomar una promoción. Conjunto cerrado a propósito: un motor de
/// reglas genérico es donde se atascan estos proyectos. Una forma nueva se añade aquí, a mano,
/// con sus parámetros y sus pruebas.
enum FormaPromocion {
  /// Un conjunto de artículos a un precio fijo.
  combo
  /// Lleva N, paga M, sobre los artículos que la promoción señale.
  nxm
  /// Un porcentaje sobre una categoría o sobre la orden entera.
  porcentaje
}

enum Plan {
  trial
  basico
  profesional
  empresarial
}

enum PlanStatus {
  trial
  active
  past_due
  canceled
  expired
}

enum TenantRole {
  Admin
  Encargado
  Mesero
  Despachador
  Cocinero
}

enum ProvisioningStatus {
  pending
  ready
  failed
}

// ----------------------------------------------------------------------------
// Plataforma (sin RLS)
// ----------------------------------------------------------------------------

model Tenant {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                  String             @unique
  nombre                String
  zitadelOrgId          String?            @unique @map("zitadel_org_id")
  zitadelProjectGrantId String?            @map("zitadel_project_grant_id")
  provisioningStatus    ProvisioningStatus @default(pending) @map("provisioning_status")
  plan                  Plan               @default(trial)
  planStatus            PlanStatus         @default(trial) @map("plan_status")
  trialEndsAt           DateTime?          @map("trial_ends_at") @db.Timestamptz(3)
  maxUsuarios           Int                @default(3) @map("max_usuarios")
  /// Desde cuándo tiene más usuarios activos de los que su plan permite. Null si cabe.
  /// Arranca el plazo tras el cual el sistema desactiva a los que sobran.
  sobreCupoDesde        DateTime?          @map("sobre_cupo_desde") @db.Timestamptz(3)
  stripeCustomerId      String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId  String?            @unique @map("stripe_subscription_id")
  /// Fin del periodo pagado: cuándo se renueva o, si hay cancelación programada, hasta cuándo sirve.
  currentPeriodEnd      DateTime?          @map("current_period_end") @db.Timestamptz(3)
  /// Cuándo termina una suscripción que se canceló desde el portal. Null si no hay cancelación.
  cancelAt              DateTime?          @map("cancel_at") @db.Timestamptz(3)
  config                Json               @default("{}")
  activo                Boolean            @default(true)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                 TenantUser[]
  avisos                AvisoEnviado[]
  counters              Counter[]
  guisos                Guiso[]
  tiposProducto         TipoProducto[]
  productos             Producto[]
  tiposPlatillo         TipoPlatillo[]
  platillos             Platillo[]
  tiposExtra            TipoExtra[]
  extras                Extra[]
  tiposOrden            TipoOrden[]
  mesas                 Mesa[]
  tiposGasto            TipoGasto[]
  gastos                Gasto[]
  cajaDiaria            CajaDiaria[]
  promociones           Promocion[]
  promocionItems        PromocionItem[]
  ordenDescuentos       OrdenDescuento[]
  ordenes               Orden[]
  subordenes            Suborden[]
  detallesPlatillo      OrdenDetallePlatillo[]
  detallesProducto      OrdenDetalleProducto[]
  detallesExtra         OrdenDetalleExtra[]

  @@index([activo])
  @@map("tenants")
}

/// Avisos por correo que ya mandó el backend, para no repetirlos. Tabla de plataforma (sin RLS).
model AvisoEnviado {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  /// `prueba-por-vencer` o `prueba-vencida`.
  tipo          String
  /// La fecha a la que se refiere el aviso: el fin de la prueba.
  referencia    DateTime @db.Timestamptz(3)
  destinatarios String
  enviadoAt     DateTime @default(now()) @map("enviado_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, tipo, referencia])
  @@map("avisos_enviados")
}

/// Quién consultó la consola de plataforma, qué y cuándo. Tabla de plataforma (sin RLS).
model BitacoraPlataforma {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operadorId    String   @map("operador_id")
  operadorEmail String   @map("operador_email")
  accion        String
  detalle       Json     @default("{}")
  creadoAt      DateTime @default(now()) @map("creado_at") @db.Timestamptz(3)

  @@index([creadoAt(sort: Desc)])
  @@map("bitacora_plataforma")
}

model StripeEvent {
  id          String    @id
  type        String
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)
  error       String?

  @@map("stripe_events")
}

// ----------------------------------------------------------------------------
// Tenant (con RLS)
// ----------------------------------------------------------------------------

model TenantUser {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String     @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  zitadelUserId String     @map("zitadel_user_id")
  email         String
  nombre        String
  role          TenantRole @default(Mesero)
  grantId       String?    @map("grant_id")
  activo        Boolean    @default(true)
  lastSeenAt    DateTime?  @map("last_seen_at") @db.Timestamptz(3)
  /// Cuándo lo desactivó el sistema al vencer el plazo de cupo. Null si lo desactivó alguien
  /// a mano o si está activo. Sirve para que la pantalla pueda decir qué pasó y no parezca
  /// que la persona desapareció sola.
  desactivadoPorCupo DateTime? @map("desactivado_por_cupo") @db.Timestamptz(3)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, zitadelUserId])
  @@unique([tenantId, email])
  @@index([tenantId, activo])
  @@map("tenant_users")
}

model Counter {
  tenantId String @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  key      String
  value    BigInt @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("counters")
}

// ---------- Catálogos ----------

model Guiso {
  id          Int      @id @default(autoincrement())
  tenantId    String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  detallesPlatillo OrdenDetallePlatillo[]

  @@unique([tenantId, id])
  @@index([tenantId, nombre])
  @@index([tenantId, activo])
  @@map("guisos")
}

model TipoProducto {
  id          Int      @id @default(autoincrement())
  tenantId    String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productos Producto[]

  @@unique([tenantId, id])
  @@index([tenantId, nombre])
  @@index([tenantId, activo])
  @@map("tipos_producto")
}

model Producto {
  id             Int      @id @default(autoincrement())
  tenantId       String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  idTipoProducto Int      @map("id_tipo_producto")
  nombre         String
  cantidad       Int      @default(0)
  costo          Decimal  @default(0) @db.Decimal(12, 2)
  variantes      Json     @default("[]")
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoProducto     TipoProducto           @relation(fields: [tenantId, idTipoProducto], references: [tenantId, id])
  detallesProducto OrdenDetalleProducto[]

  @@unique([tenantId, id])
  @@index([tenantId, nombre])
  @@index([tenantId, idTipoProducto])
  @@index([tenantId, activo])
  @@index([tenantId, cantidad])
  @@map("productos")
  promocionItems PromocionItem[]
}

model TipoPlatillo {
  id          Int      @id @default(autoincrement())
  tenantId    String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platillos Platillo[]

  @@unique([tenantId, id])
  @@index([tenantId, nombre])
  @@index([tenantId, activo])
  @@map("tipos_platillo")
  promociones Promocion[]
}

model Platillo {
  id             Int      @id @default(autoincrement())
  tenantId       String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  idTipoPlatillo Int      @map("id_tipo_platillo")
  nombre         String
  descripcion    String?
  costo          Decimal  @default(0) @db.Decimal(12, 2)
  precio         Decimal  @default(0) @db.Decimal(12, 2)
  notas          String?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoPlatillo     TipoPlatillo           @relation(fields: [tenantId, idTipoPlatillo], references: [tenantId, id])
  detallesPlatillo OrdenDetallePlatillo[]

  @@unique([tenantId, id])
  @@index([tenantId, nombre])
  @@index([tenantId, idTipoPlatillo])
  @@index([tenantId, activo])
  @@map("platillos")
  promocionItems PromocionItem[]
}

model TipoExtra {
  id          Int      @id @default(autoincrement())
  tenantId    String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  nombre      String
  descripcion String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  extras Extra[]

  @@unique([tenantId, id])
  @@index([tenantId, nombre])
  @@index([tenantId, activo])
  @@map("tipos_extra")
}

model Extra {
  id          Int      @id @default(autoincrement())
  tenantId    String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  idTipoExtra Int      @map("id_tipo_extra")
  nombre      String
  descripcion String?
  costo       Decimal  @default(0) @db.Decimal(12, 2)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoExtra     TipoExtra           @relation(fields: [tenantId, idTipoExtra], references: [tenantId, id])
  detallesExtra OrdenDetalleExtra[]

  @@unique([tenantId, id])
  @@index([tenantId, nombre])
  @@index([tenantId, idTipoExtra])
  @@index([tenantId, activo])
  @@map("extras")
}

model TipoOrden {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ordenes Orden[]

  @@unique([tenantId, id])
  @@index([tenantId, nombre])
  @@map("tipos_orden")
}

model Mesa {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  nombre    String
  activo    Boolean  @default(true)
  /// La de un pedido para llevar: se desactiva sola cuando su última orden se cierra.
  temporal  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ordenes Orden[]

  @@unique([tenantId, id])
  @@index([tenantId, nombre])
  @@index([tenantId, activo])
  @@map("mesas")
}

model TipoGasto {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gastos Gasto[]

  @@unique([tenantId, id])
  @@index([tenantId, nombre])
  @@map("tipos_gasto")
}

model Gasto {
  id          Int      @id @default(autoincrement())
  tenantId    String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  idTipoGasto Int      @map("id_tipo_gasto")
  nombre      String
  gastoTotal  Decimal  @default(0) @map("gasto_total") @db.Decimal(12, 2)
  descripcion String?
  fecha       DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoGasto TipoGasto @relation(fields: [tenantId, idTipoGasto], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, fecha(sort: Desc)])
  @@index([tenantId, idTipoGasto])
  @@map("gastos")
}

/// El dinero en caja de un día, que el reporte suma a las ventas para la utilidad.
///
/// Vivía en el `localStorage` del navegador: no se compartía entre dispositivos, no entraba en
/// el respaldo, se borraba al limpiar el navegador y dos restaurantes abiertos en el mismo
/// navegador compartían la misma llave.
model CajaDiaria {
  id        Int      @id @default(autoincrement())
  tenantId  String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  /// El día del negocio, sin hora: así no hay zona horaria que interpretar.
  fecha     DateTime @db.Date
  monto     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fecha])
  @@map("caja_diaria")
}

/// Una regla que le baja el precio a una orden.
///
/// La vigencia se evalúa en la zona horaria del negocio, en el servidor: una hora feliz de 16 a
/// 18 interpretada en UTC empieza a las diez de la mañana en México.
model Promocion {
  id         Int            @id @default(autoincrement())
  tenantId   String         @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  nombre     String
  forma      FormaPromocion
  activo     Boolean        @default(true)
  /// Si no, solo se concede la que más favorece al cliente.
  combinable Boolean        @default(false)

  /// combo: el precio del conjunto.
  precio     Decimal? @db.Decimal(12, 2)
  /// nxm: se lleva `lleva` y paga `paga`.
  lleva      Int?
  paga       Int?
  /// porcentaje: cuánto se descuenta.
  porcentaje Decimal? @db.Decimal(5, 2)

  /// Alcance opcional por categoría de platillo; sin él y sin items, aplica a toda la orden.
  idTipoPlatillo Int? @map("id_tipo_platillo")

  /// Vigencia. Null en todos = siempre.
  desde      DateTime? @db.Date
  hasta      DateTime? @db.Date
  /// 0 = domingo. Vacío = todos los días.
  diasSemana Int[]     @map("dias_semana")
  /// `HH:MM` en la zona del negocio.
  horaInicio String?   @map("hora_inicio")
  horaFin    String?   @map("hora_fin")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoPlatillo  TipoPlatillo?    @relation(fields: [tenantId, idTipoPlatillo], references: [tenantId, id])
  items         PromocionItem[]
  descuentos    OrdenDescuento[]

  @@unique([tenantId, id])
  @@index([tenantId, activo])
  @@map("promociones")
}

/// Qué artículos entran en una promoción: los del combo, o aquellos sobre los que cuenta el NxM.
model PromocionItem {
  id          Int    @id @default(autoincrement())
  tenantId    String @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  idPromocion Int    @map("id_promocion")
  idPlatillo  Int?   @map("id_platillo")
  idProducto  Int?   @map("id_producto")
  cantidad    Int    @default(1)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promocion Promocion @relation(fields: [tenantId, idPromocion], references: [tenantId, id], onDelete: Cascade)
  platillo  Platillo? @relation(fields: [tenantId, idPlatillo], references: [tenantId, id])
  producto  Producto? @relation(fields: [tenantId, idProducto], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, idPromocion])
  @@map("promocion_items")
}

/// Lo que una promoción o un combo le quita a una orden.
///
/// Es una línea más, con importe negativo, y por eso el total sigue siendo la suma de las
/// líneas. Guardar solo una columna `descuento` en la orden habría perdido el porqué: no
/// distinguiría un combo de una promoción ni permitiría reportar por cuál se aplicó.
///
/// `nombre` es copia de la promoción en el momento de venderse, igual que las líneas copian
/// `nombrePlatillo`: lo que se vendió se cuenta como era el día que se vendió, aunque después
/// la promoción se renombre o se retire.
model OrdenDescuento {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  idOrden     String   @map("id_orden") @db.Uuid
  idPromocion Int      @map("id_promocion")
  nombre      String
  importe     Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orden     Orden      @relation(fields: [tenantId, idOrden], references: [tenantId, id], onDelete: Cascade)
  /// Una promoción que ya se aplicó no se borra: se desactiva. Así ninguna orden pasada pierde
  /// de dónde salió su descuento.
  promocion Promocion  @relation(fields: [tenantId, idPromocion], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, idOrden])
  @@index([tenantId, idPromocion])
  @@map("orden_descuentos")
}

// ---------- Órdenes ----------

model Orden {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String       @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  folio           String
  idTipoOrden     Int          @map("id_tipo_orden")
  nombreTipoOrden String       @map("nombre_tipo_orden")
  estatus         OrdenEstatus @default(Recepcion)
  idMesa          Int?         @map("id_mesa")
  nombreMesa      String?      @map("nombre_mesa")
  nombreCliente   String?      @map("nombre_cliente")
  fechaHora       DateTime     @default(now()) @map("fecha_hora") @db.Timestamptz(3)
  fechaPago       DateTime?    @map("fecha_pago") @db.Timestamptz(3)
  total           Decimal      @default(0) @db.Decimal(12, 2)
  notas           String?
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipoOrden  TipoOrden              @relation(fields: [tenantId, idTipoOrden], references: [tenantId, id])
  mesa       Mesa?                  @relation(fields: [tenantId, idMesa], references: [tenantId, id])
  subordenes  Suborden[]
  productos   OrdenDetalleProducto[]
  descuentos  OrdenDescuento[]

  @@unique([tenantId, folio])
  @@unique([tenantId, id])
  @@index([tenantId, estatus])
  @@index([tenantId, fechaHora(sort: Desc)])
  @@index([tenantId, idMesa])
  @@map("ordenes")
}

model Suborden {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  idOrden   String   @map("id_orden") @db.Uuid
  nombre    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orden     Orden                  @relation(fields: [tenantId, idOrden], references: [tenantId, id], onDelete: Cascade)
  platillos OrdenDetallePlatillo[]

  @@unique([tenantId, id])
  @@index([tenantId, idOrden])
  @@map("subordenes")
}

model OrdenDetallePlatillo {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  idSuborden     String   @map("id_suborden") @db.Uuid
  idPlatillo     Int      @map("id_platillo")
  nombrePlatillo String   @map("nombre_platillo")
  idGuiso        Int      @map("id_guiso")
  nombreGuiso    String   @map("nombre_guiso")
  costoPlatillo  Decimal  @map("costo_platillo") @db.Decimal(12, 2)
  cantidad       Int      @default(1)
  importe        Decimal  @db.Decimal(12, 2)
  notas          String?
  listo          Boolean  @default(false)
  entregado      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  suborden Suborden            @relation(fields: [tenantId, idSuborden], references: [tenantId, id], onDelete: Cascade)
  platillo Platillo            @relation(fields: [tenantId, idPlatillo], references: [tenantId, id])
  guiso    Guiso               @relation(fields: [tenantId, idGuiso], references: [tenantId, id])
  extras   OrdenDetalleExtra[]

  @@unique([tenantId, id])
  @@index([tenantId, idSuborden])
  @@index([tenantId, idPlatillo])
  @@map("orden_detalle_platillos")
}

model OrdenDetalleProducto {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  idOrden        String   @map("id_orden") @db.Uuid
  idProducto     Int      @map("id_producto")
  nombreProducto String   @map("nombre_producto")
  costoProducto  Decimal  @map("costo_producto") @db.Decimal(12, 2)
  cantidad       Int      @default(1)
  importe        Decimal  @db.Decimal(12, 2)
  listo          Boolean  @default(false)
  entregado      Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orden    Orden    @relation(fields: [tenantId, idOrden], references: [tenantId, id], onDelete: Cascade)
  producto Producto @relation(fields: [tenantId, idProducto], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, idOrden])
  @@index([tenantId, idProducto])
  @@map("orden_detalle_productos")
}

model OrdenDetalleExtra {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String   @default(dbgenerated("current_tenant_id()")) @map("tenant_id") @db.Uuid
  idOrdenDetallePlatillo String   @map("id_orden_detalle_platillo") @db.Uuid
  idExtra                Int      @map("id_extra")
  nombreExtra            String   @map("nombre_extra")
  costoExtra             Decimal  @map("costo_extra") @db.Decimal(12, 2)
  cantidad               Int      @default(1)
  importe                Decimal  @db.Decimal(12, 2)
  listo                  Boolean  @default(false)
  entregado              Boolean  @default(false)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  detallePlatillo OrdenDetallePlatillo @relation(fields: [tenantId, idOrdenDetallePlatillo], references: [tenantId, id], onDelete: Cascade)
  extra           Extra                @relation(fields: [tenantId, idExtra], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, idOrdenDetallePlatillo])
  @@index([tenantId, idExtra])
  @@map("orden_detalle_extras")
}
