# Configuración del respaldo externo.
#
#   cp infra/respaldo/.env.respaldo.example infra/respaldo/.env.respaldo
#   chmod 600 infra/respaldo/.env.respaldo
#
# ATENCIÓN: este archivo NO va dentro del respaldo, a propósito. Contiene la llave que
# descifra el respaldo, así que guardarlo dentro no serviría de nada. Su contenido vive en el
# gestor de contraseñas, en la entrada "Kustodela — sobre de arranque". Ver docs/recuperacion.md.

# --- Repositorio restic en Cloudflare R2 -------------------------------------------------
# El endpoint sale del panel de R2: s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>
RESTIC_REPOSITORY=s3:https://XXXXXXXXXXXX.r2.cloudflarestorage.com/kustodela-respaldo

# Frase larga y aleatoria. Si se pierde, el respaldo es irrecuperable: no hay forma de
# regenerarla ni de que Cloudflare la reponga. Genérala con:  openssl rand -base64 36
RESTIC_PASSWORD=

# Token de API de R2 con acceso de lectura y escritura SOLO a este bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Vigilante de fallo silencioso -------------------------------------------------------
# URL del check en healthchecks.io. El guion hace ping solo cuando termina bien; si el
# respaldo deja de ocurrir, llega un correo sin que nadie tenga que revisar el servidor.
# Configúralo con periodo 6 horas y margen 2 horas.
HEALTHCHECK_URL=

# --- Identidad de este servidor ----------------------------------------------------------
# Con qué nombre agrupa restic las instantáneas. Importa más de lo que parece: `forget` aplica
# la retención por grupo (host + rutas), así que cambiarlo dejaría las instantáneas anteriores
# en un grupo aparte, con su propia política.
#
# Si ya hay instantáneas en el repositorio, pon EXACTAMENTE el mismo host que usan. Consúltalo:
#   docker compose run --rm respaldo restic snapshots
RESPALDO_SERVIDOR=

# --- Frescura del volcado ----------------------------------------------------------------
# El respaldo ya no dispara el volcado (eso exigiría el socket de Docker): fotografía el más
# reciente que haya dejado pg-backup y falla si está viejo. Al fallar no avisa al vigilante,
# así que el correo llega igual. Debe ser algo mayor que la cadencia de BACKUP_SCHEDULE, para
# tolerar un volcado lento pero NO una tanda entera saltada.
RESPALDO_FRESCURA_HORAS=7

# Política de retención en R2.
RETENCION_DIARIA=14
RETENCION_SEMANAL=8
RETENCION_MENSUAL=12
