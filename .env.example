# Copia a .env. Valores de ejemplo SOLO para desarrollo local (docker-compose.dev.yaml).
# En producción (docker-compose.yaml) todos los secretos se generan nuevos y nunca se versionan.
# Genera secretos con: openssl rand -base64 24   (masterkey: openssl rand -hex 16 -> 32 caracteres)

# ---- Dominio de la aplicación (única fuente de verdad; ver docs/cambiar-dominio.md) ----
APP_DOMAIN=localhost
APP_SCHEME=http
APP_TZ=America/Mexico_City
# Subdominio de la plataforma (landing y registro): https://<APP_PLATFORM_HOST>.<APP_DOMAIN>.
# Cámbialo si `app` ya lo usa otro sitio. Queda reservado como slug de restaurante.
APP_PLATFORM_HOST=app

# ---- PostgreSQL ----
POSTGRES_ADMIN_PASSWORD=postgres
POS_MIGRATOR_PASSWORD=pos_migrator_dev
POS_APP_PASSWORD=pos_app_dev
ZITADEL_DB_PASSWORD=zitadel_dev

# ---- Zitadel ----
ZITADEL_VERSION=v4.17.3
# Exactamente 32 caracteres. En producción: respaldar aparte; sin ella la base de Zitadel es inservible.
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
# Solo local (en producción el dominio externo es auth.${APP_DOMAIN}:443).
ZITADEL_EXTERNAL_DOMAIN=localhost
ZITADEL_EXTERNAL_PORT=8080
# Política por defecto: 8+ caracteres, mayúscula, minúscula, número y símbolo.
ZITADEL_ADMIN_PASSWORD=Admin1234!
ZITADEL_ADMIN_EMAIL=admin@kustodela.local

# ---- Solo producción (docker-compose.yaml) ----
# Correo para avisos de Let's Encrypt.
# ACME_EMAIL=
# Token de Cloudflare con permiso Zone:DNS:Edit únicamente sobre la zona de APP_DOMAIN.
# CLOUDFLARE_API_TOKEN=
# Para ensayar la emisión del certificado sin agotar la cuota de Let's Encrypt:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# BACKEND_LOG_LEVEL=info
# BACKUP_SCHEDULE=@daily
# BACKUP_KEEP_DAYS=14
